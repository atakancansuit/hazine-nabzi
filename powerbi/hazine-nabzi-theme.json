{
  "name": "Hazine Nabzı",
  "dataColors": [
    "#222d56",
    "#c7a069",
    "#dc3545",
    "#198754",
    "#4b5a8c",
    "#dcb672",
    "#6c757d",
    "#101855"
  ],
  "foreground": "#212529",
  "foregroundNeutralSecondary": "#6c757d",
  "background": "#FFFFFF",
  "backgroundLight": "#f8f9fa",
  "tableAccent": "#222d56",
  "good": "#198754",
  "neutral": "#6c757d",
  "bad": "#dc3545",
  "textClasses": {
    "title": {
      "fontSize": 18,
      "fontFace": "Segoe UI Semibold",
      "color": "#101855"
    },
    "header": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#101855"
    },
    "label": {
      "fontSize": 13,
      "fontFace": "Segoe UI",
      "color": "#5A6169"
    },
    "callout": {
      "fontSize": 44,
      "fontFace": "Segoe UI Light",
      "color": "#222d56"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#c7a069"
              }
            },
            "radius": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#101855"
              }
            },
            "fontSize": 16,
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#6c757d"
              }
            },
            "fontSize": 12,
            "alignment": "left"
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#101855"
              }
            },
            "preset": "Outer",
            "transparency": 70
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#222d56"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#101855"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "showMarker": true,
            "markerSize": 4
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false,
            "showAxisTitle": false,
            "fontSize": 13
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#dee2e6"
              }
            },
            "showAxisTitle": false,
            "fontSize": 13
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopCenter",
            "showTitle": false,
            "fontSize": 13
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [
          {
            "gridlineShow": false,
            "showAxisTitle": false,
            "fontSize": 13
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#dee2e6"
              }
            },
            "showAxisTitle": false,
            "fontSize": 13
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 12
          }
        ],
        "legend": [
          {
            "show": false
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [
          {
            "gridlineShow": false,
            "showAxisTitle": false,
            "fontSize": 13
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#dee2e6"
              }
            },
            "showAxisTitle": false,
            "fontSize": 13
          }
        ],
        "legend": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EDEFF2"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#222d56"
              }
            },
            "fontSize": 13
          }
        ],
        "values": [
          {
            "fontSize": 13,
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#f8f9fa"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#101855"
              }
            },
            "backColor": {
              "solid": {
                "color": "#eeefed"
              }
            },
            "fontSize": 13
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "fontSize": 30,
            "color": {
              "solid": {
                "color": "#222d56"
              }
            }
          }
        ],
        "label": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#5A6169"
              }
            },
            "fontSize": 13
          }
        ],
        "items": [
          {
            "fontSize": 14
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 40,
            "color": {
              "solid": {
                "color": "#222d56"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ]
      }
    }
  },
  "backgroundNeutral": "#eeefed"
}